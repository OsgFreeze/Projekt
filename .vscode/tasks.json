{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Ollama",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\start-ollama.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Backend",
            "type": "shell",
            "command": "uvicorn app.main:app --reload",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true
        },
        {
            "label": "Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true
        },
        {
            "label": "App",
            "dependsOn": [
                "Backend",
                "Frontend"
            ],
            "dependsOrder": "parallel"
        },
        {
            "label": "Start Full Stack",
            "dependsOn": [
                "Ollama",
                "App"
            ],
            "dependsOrder": "sequence"
        }
    ]
}